# Copy to tools/.env and fill in. tools/.env is gitignored — keys never reach the app/browser.
# Create an R2 API token in Cloudflare: R2 > Manage API Tokens > Create (Object Read & Write).

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=phbyviki

# Optional overrides:
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MAX_EDGE=2048
# WEBP_QUALITY=82
